# Server Configuration
PROJECT_NAME=SettlerPulse API
ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Use local MongoDB (mongodb://localhost:27017) or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
DB_NAME=settlerpulse_db

# Security / Authentication
JWT_SECRET_KEY=change_this_super_secret_key_in_production_12345!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Google Gemini)
# Obtain your free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
